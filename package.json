{
  "name": "use-ackee",
  "version": "3.1.0",
  "description": "Use Ackee in React",
  "keywords": [
    "react",
    "hooks",
    "hook",
    "tracker",
    "analytics",
    "tracking",
    "ackee"
  ],
  "homepage": "https://github.com/electerious/use-ackee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electerious/use-ackee.git"
  },
  "license": "MIT",
  "main": "src/index.js",
  "files": [
    "src"
  ],
  "scripts": {
    "eslint": "eslint \"**/*.{js,mjs}\"",
    "format": "npm run eslint -- --fix && npm run prettier -- --write",
    "lint": "npm run eslint && npm run prettier -- --check",
    "prettier": "prettier --ignore-path .gitignore \"src/**/*.js\" \"test/**/*.js\" README.md CHANGELOG.md package.json \".github/**/*.yml\" eslint.config.mjs prettier.config.mjs",
    "test": "npm run lint && node --experimental-test-coverage --test"
  },
  "dependencies": {
    "ackee-tracker": "^5.1.0"
  },
  "devDependencies": {
    "@electerious/eslint-config": "^6.0.0",
    "@electerious/prettier-config": "^5.0.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "authors": [
    "Tobias Reich <tobias@electerious.com>"
  ]
}
